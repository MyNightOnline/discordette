{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client"], "noEmit": true, "allowImportingTsExtensions": true, "allowJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"], "exclude": ["src/**/*.test.ts"]
}
